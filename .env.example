# Variables lues par Docker Compose, pour les deux piles :
#   docker-compose.yml            services de développement (base et cache seuls)
#   docker-compose.production.yml pile complète (interface, API, base, cache)
#
# Copier ce fichier vers .env à la racine et renseigner les valeurs du poste.
# Ce .env est distinct de backend/.env : celui-ci configure les conteneurs, celui-là
# configure l'API lorsqu'elle tourne directement sur le poste. Aucun des deux n'est
# versionné, aucune valeur réelle ne doit figurer ici.

# --- Communes aux deux piles ---

# Identifiants du service PostgreSQL. Cet utilisateur est le propriétaire de la base :
# il crée le schéma, mais ce n'est pas lui que l'API utilise en pile complète.
POSTGRES_USER=capitall
POSTGRES_PASSWORD=
# schema.sql accorde explicitement les droits sur la base nommée capitall.
# Changer ce nom suppose d'adapter le script.
POSTGRES_DB=capitall

# --- Pile de développement uniquement ---

# Ports publiés sur le poste. À changer si un serveur local occupe déjà ces ports.
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Pile complète uniquement ---
# La pile de développement ignore ces variables.

# Mot de passe du rôle applicatif capitall_app, avec lequel l'API se connecte à la base.
# Le rôle est créé par schema.sql sans mot de passe utilisable ; celui-ci lui est posé
# à l'initialisation du volume de données.
CAPITALL_APP_PASSWORD=

# Secret de signature des jetons JWT, 32 caractères au minimum. L'API refuse de
# démarrer en dessous. Générer une valeur aléatoire propre à chaque environnement.
JWT_SECRET=

# Durée de validité des jetons émis. Optionnel, 2h par défaut.
JWT_EXPIRATION=2h

# Port sur lequel l'application est publiée sur la machine hôte. C'est le seul port
# ouvert par la pile complète : ni la base, ni le cache, ni l'API ne sont exposés.
PORT_APPLICATION=8080

# Origine autorisée à appeler l'API. Doit correspondre à l'adresse par laquelle
# l'interface est réellement atteinte, port compris.
ORIGINE_AUTORISEE=http://localhost:8080
