# Modèle de configuration du back-end.
# Copier ce fichier vers backend/.env et renseigner les valeurs propres au poste.
# Le fichier .env n'est jamais versionné : aucune valeur réelle ne doit figurer ici.

# Port d'écoute de l'API. Optionnel, 5000 par défaut.
PORT=5000

# Environnement d'exécution : development, test ou production. Optionnel, development par défaut.
NODE_ENV=development

# Chaîne de connexion PostgreSQL. Obligatoire, le serveur refuse de démarrer sans elle.
# Format : postgresql://utilisateur:mot_de_passe@hote:port/base
# Si la base tourne dans le conteneur du docker-compose, le port indiqué ici doit
# correspondre à POSTGRES_PORT du .env de la racine, qui n'est pas nécessairement 5432
# lorsqu'une installation locale de PostgreSQL occupe déjà ce port.
DATABASE_URL=postgresql://utilisateur:mot_de_passe@localhost:5432/capitall

# Secret de signature des jetons JWT. Obligatoire, 32 caractères au minimum.
# Générer une valeur aléatoire par environnement, ne jamais réutiliser celle d'un autre poste.
JWT_SECRET=

# Durée de validité des jetons émis. Optionnel, 2h par défaut.
# Accepte les formats de la bibliothèque jsonwebtoken : 2h, 30m, 7d.
JWT_EXPIRATION=2h

# Chaîne de connexion Redis, utilisée par le cache des cours.
REDIS_URL=redis://localhost:6379

# Origine autorisée à appeler l'API depuis un navigateur. Optionnel en développement,
# où le serveur de Vite écoute sur http://localhost:5173. À renseigner avec le domaine
# de l'interface en production.
ORIGINE_AUTORISEE=http://localhost:5173

# Fournisseurs des cours d'actions. Optionnels : sans clé, les autres classes d'actif
# restent disponibles. L'ordre de repli est FMP, Finnhub, puis Alpha Vantage.
FMP_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Affiche la clé de réinitialisation dans la réponse au lieu de l'envoyer par courriel,
# le projet n'ayant pas de service d'envoi. Commodité de démonstration uniquement.
#
# Elle a un coût qu'il faut connaître avant de l'ouvrir : la clé n'apparaît que si
# l'adresse correspond à un compte, ce qui révèle l'existence de ce compte. Fermée par
# défaut, elle n'a rien à faire sur un déploiement réel.
AFFICHER_JETON_REINITIALISATION=false
